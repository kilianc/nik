# Ignore everything by default
*

# Unignore directories (required for nested file matching)
!*/

# Track Go source and dependencies
!*.go
!go.mod
!go.sum

# Track SQL and sqlc config
!internal/db/schema.sql
!internal/queries/*.sql

# Track gateway wire fixtures (byte-identical copies of nik-saas's)
!internal/gateway/testdata/*.json

# Track templates
!*.tmpl

# Track build
!Makefile
!internal/shell/Dockerfile

# Track the release of record (written only by `make release`)
!VERSION

# Track docs
!.gitignore
!*.md
!AGENTS.md
!config.example.yaml

# Track scripts and service files
!*.sh
!bin/check-layering
!bin/check-commits
!*.service
!*.timer

# Track GitHub Actions workflows
!.github/workflows/*.yaml
!.github/workflows/*.yml

# Always ignore
.claude/
.cursor/
TODO.md
workspace/
workbench/
